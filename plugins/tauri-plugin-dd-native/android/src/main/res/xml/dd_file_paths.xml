<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes only the "DD Compressor" subfolder of this app's own external
  files directory (where SaveFileHelper.kt writes compressed output) —
  nothing else on the device is reachable through this FileProvider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="dd_compressed_output" path="DD Compressor/" />
</paths>
